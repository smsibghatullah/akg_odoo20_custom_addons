<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Name contains "proforma" on purpose: akg_doc_reports' template swap
         leaves pro-forma templates alone. -->
    <template id="report_proforma_akg">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="akg_proforma_report.proforma_document_akg" t-lang="doc._akgr_lang()"/>
            </t>
        </t>
    </template>

    <template id="proforma_document_akg">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="cur" t-value="doc.currency_id"/>
        <t t-set="digits" t-value="cur.decimal_places"/>
        <t t-set="info_rows" t-value="doc._akgr_info_rows()"/>
        <t t-set="lines" t-value="doc._akgr_lines()"/>
        <t t-set="totals" t-value="doc._akgr_totals()"/>
        <t t-set="notes" t-value="doc._akgr_notes()"/>
        <t t-set="bill_partner" t-value="doc.partner_invoice_id or doc.partner_id"/>
        <t t-set="ship_partner" t-value="doc.partner_shipping_id if doc.partner_shipping_id and doc.partner_shipping_id != bill_partner else False"/>
        <t t-set="show_discount" t-value="any(l.get('discount') for l in lines if l['type'] == 'line')"/>

        <div t-attf-class="article akgr o_company_#{company.id}_layout" dir="ltr"
             t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <t t-call="akg_doc_reports.akgr_css"/>

            <table style="margin-top:4px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:58%; padding-right:20px;border:0 none !important">
                        <t t-if="ship_partner">
                            <div class="lb">Shipping address:</div>
                            <address t-out="doc._akgr_addr(ship_partner)"/>
                        </t>
                    </td>
                    <td style="width:42%;border:0 none !important">
                        <address t-out="doc._akgr_addr(bill_partner)"/>
                        <div t-if="bill_partner.vat" style="font-size:15px;">Tax ID: <t t-out="bill_partner.vat"/></div>
                    </td>
                </tr>
            </table>

            <div class="title">Pro-Forma Invoice # <t t-out="doc.name"/></div>

            <t t-call="akg_doc_reports.akgr_info"/>

            <table class="lines" style="border:0 none !important;border-bottom:2px solid #444 !important">
                <thead style="border:0 none !important">
                    <tr style="border:0 none !important">
                        <th class="l" style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Description</th>
                        <th style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Quantity</th>
                        <th style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Unit Price</th>
                        <th t-if="show_discount" style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Disc.%</th>
                        <th style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Taxes</th>
                        <th style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Amount</th>
                    </tr>
                </thead>
                <tbody style="border:0 none !important">
                    <t t-foreach="lines" t-as="line">
                        <tr t-if="line['type'] == 'line'" style="border:0 none !important">
                            <td class="l first" style="white-space: pre-line;border:0 none !important;border-bottom:1px solid #ccc !important"><t t-out="line['name']"/></td>
                            <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important">
                                <span t-out="line['qty']" t-options='{"widget": "float", "precision": 2}'/>
                                <t t-out="line['uom']"/>
                            </td>
                            <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><span t-out="line['price_unit']" t-options='{"widget": "float", "precision": digits}'/></td>
                            <td t-if="show_discount" style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><span t-out="line['discount']" t-options='{"widget": "float", "precision": 2}'/></td>
                            <td style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><t t-out="line['taxes']"/></td>
                            <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><span t-out="line['subtotal']" t-options='{"widget": "monetary", "display_currency": cur}'/></td>
                        </tr>
                        <tr t-elif="line['type'] == 'line_section'" style="border:0 none !important">
                            <td colspan="99" class="l first" style="background:#eee; font-weight:bold;border:0 none !important;border-bottom:1px solid #ccc !important"><t t-out="line['name']"/></td>
                        </tr>
                        <tr t-else="" style="border:0 none !important">
                            <td colspan="99" class="l first" style="font-style:italic;border:0 none !important;border-bottom:1px solid #ccc !important"><t t-out="line['name']"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-call="akg_doc_reports.akgr_totals"/>

            <div t-if="notes['note']" style="margin-top:16px;"><t t-out="notes['note']"/></div>
            <div t-if="notes['payment']" style="margin-top:10px;"><t t-out="notes['payment']"/></div>
        </div>

        <!-- header + footer repeat on EVERY page (div.header / div.footer) -->
        <t t-call="akg_report_layout.akg_header"/>
        <t t-call="akg_doc_reports.akgr_footer"/>
    </template>
</odoo>
