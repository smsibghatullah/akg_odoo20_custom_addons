<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own Print-menu entry for Sales Orders. No groups: every internal user sees it. -->
    <record id="action_report_proforma_akg" model="ir.actions.report">
        <field name="name">PRO-FORMA Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">akg_proforma_report.report_proforma_akg</field>
        <field name="print_report_name">'PRO-FORMA - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="akg_doc_reports.paperformat_akgr"/>
    </record>

    <function model="ir.actions.report" name="_akgpf_apply_report"/>
</odoo>
