<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_akg">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="akg_doc_reports.picking_document_akg" t-lang="doc._akgr_lang()"/>
            </t>
        </t>
    </template>

    <template id="picking_document_akg">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="info_rows" t-value="doc._akgr_info_rows()"/>
        <t t-set="lines" t-value="doc._akgr_lines()"/>
        <t t-set="code" t-value="doc._akgr_code()"/>
        <t t-set="barcode_uri" t-value="doc._akgr_barcode_uri()"/>
        <t t-set="wh_partner" t-value="doc._akgr_warehouse_partner()"/>
        <t t-set="show_lots" t-value="any(l['lots'] for l in lines)"/>

        <div t-attf-class="article akgr o_company_#{company.id}_layout" dir="ltr"
             t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <t t-call="akg_doc_reports.akgr_css"/>
            <t t-call="akg_report_layout.akg_header_inline"/>

            <div t-if="barcode_uri" style="text-align:right; margin-top:4px;">
                <img t-att-src="barcode_uri" style="width:300px; height:50px;"/>
            </div>

            <table style="margin-top:14px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:58%; padding-right:20px;border:0 none !important">
                        <t t-if="wh_partner">
                            <div class="lb">Warehouse Address:</div>
                            <address t-out="doc._akgr_addr(wh_partner)"/>
                        </t>
                    </td>
                    <td style="width:42%;border:0 none !important">
                        <t t-if="doc.partner_id">
                            <div class="lb"><t t-out="doc._akgr_partner_label()"/></div>
                            <address t-out="doc._akgr_addr(doc.partner_id)"/>
                        </t>
                    </td>
                </tr>
            </table>

            <div class="title" style="margin-bottom:6px;"><t t-out="doc.name"/></div>

            <t t-call="akg_doc_reports.akgr_info"/>

            <table class="lines" style="border:0 none !important;border-bottom:2px solid #444 !important">
                <thead style="border:0 none !important">
                    <tr style="border:0 none !important">
                        <th class="l" style="text-align:center;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Product</th>
                        <th class="l" style="text-align:center;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Quantity</th>
                        <th t-if="show_lots" class="l" style="text-align:center;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">Lot/Serial</th>
                        <th t-if="code != 'incoming'" class="l" style="text-align:center;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">From</th>
                        <th t-if="code != 'outgoing'" class="l" style="text-align:center;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important">To</th>
                    </tr>
                </thead>
                <tbody style="border:0 none !important">
                    <tr t-foreach="lines" t-as="line" style="border:0 none !important">
                        <td class="l first" style="white-space: pre-line;border:0 none !important;border-bottom:1px solid #ccc !important"><t t-out="line['name']"/></td>
                        <td class="l" style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important">
                            <span t-out="line['qty']" t-options='{"widget": "float", "precision": 2}'/>
                            <t t-out="line['uom']"/>
                        </td>
                        <td t-if="show_lots" class="l" style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><t t-out="line['lots']"/></td>
                        <td t-if="code != 'incoming'" class="l" style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><t t-out="line['from']"/></td>
                        <td t-if="code != 'outgoing'" class="l" style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><t t-out="line['to']"/></td>
                    </tr>
                </tbody>
            </table>

            <div t-if="doc._akgr_note()" style="margin-top:16px;"><t t-out="doc._akgr_note()"/></div>
        </div>

        <t t-call="akg_doc_reports.akgr_footer"/>
    </template>
</odoo>
