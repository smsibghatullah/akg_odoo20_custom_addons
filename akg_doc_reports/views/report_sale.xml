<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_akg">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="akg_doc_reports.saleorder_document_akg" t-lang="doc._akgr_lang()"/>
            </t>
        </t>
    </template>

    <template id="saleorder_document_akg">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="cur" t-value="doc.currency_id"/>
        <t t-set="digits" t-value="cur.decimal_places"/>
        <t t-set="info_rows" t-value="doc._akgr_info_rows()"/>
        <t t-set="lines" t-value="doc._akgr_lines()"/>
        <t t-set="totals" t-value="doc._akgr_totals()"/>
        <t t-set="notes" t-value="doc._akgr_notes()"/>
        <t t-set="bill_partner" t-value="doc.partner_invoice_id or doc.partner_id"/>
        <t t-set="ship_partner" t-value="doc.partner_shipping_id if doc.partner_shipping_id and doc.partner_shipping_id != bill_partner else False"/>
        <t t-set="show_discount" t-value="any(l.get('discount') for l in lines if l['type'] == 'line')"/>

        <t t-call="akg_doc_reports.akgr_header"/>

        <div t-attf-class="article akgr o_company_#{company.id}_layout" dir="ltr"
             t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <t t-call="akg_doc_reports.akgr_css"/>

            <table style="margin-top:4px;">
                <tr>
                    <td style="width:50%; padding-right:20px;">
                        <t t-if="ship_partner">
                            <div class="lb">Shipping address:</div>
                            <address t-out="doc._akgr_addr(ship_partner)"/>
                        </t>
                    </td>
                    <td style="width:50%;">
                        <address t-out="doc._akgr_addr(bill_partner)"/>
                        <div t-if="bill_partner.vat" style="font-size:14px;">Tax ID: <t t-out="bill_partner.vat"/></div>
                    </td>
                </tr>
            </table>

            <div class="title"><t t-out="doc._akgr_title()"/> <t t-out="doc.name"/></div>

            <t t-call="akg_doc_reports.akgr_info"/>

            <table class="lines">
                <thead>
                    <tr>
                        <th class="l">Description</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th t-if="show_discount">Disc.%</th>
                        <th>Taxes</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <tr t-if="line['type'] == 'line'">
                            <td class="l first" style="white-space: pre-line;"><t t-out="line['name']"/></td>
                            <td style="white-space:nowrap;">
                                <span t-out="line['qty']" t-options='{"widget": "float", "precision": 2}'/>
                                <t t-out="line['uom']"/>
                            </td>
                            <td style="white-space:nowrap;"><span t-out="line['price_unit']" t-options='{"widget": "float", "precision": digits}'/></td>
                            <td t-if="show_discount"><span t-out="line['discount']" t-options='{"widget": "float", "precision": 2}'/></td>
                            <td><t t-out="line['taxes']"/></td>
                            <td style="white-space:nowrap;"><span t-out="line['subtotal']" t-options='{"widget": "monetary", "display_currency": cur}'/></td>
                        </tr>
                        <tr t-elif="line['type'] == 'line_section'">
                            <td colspan="99" class="l first" style="background:#eee; font-weight:bold;"><t t-out="line['name']"/></td>
                        </tr>
                        <tr t-else="">
                            <td colspan="99" class="l first" style="font-style:italic;"><t t-out="line['name']"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-call="akg_doc_reports.akgr_totals"/>

            <div t-if="notes['note']" style="margin-top:16px;"><t t-out="notes['note']"/></div>
            <div t-if="notes['payment']" style="margin-top:10px;"><t t-out="notes['payment']"/></div>
        </div>

        <t t-call="akg_doc_reports.akgr_footer"/>
    </template>
</odoo>
