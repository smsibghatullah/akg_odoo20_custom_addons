<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared CSS. Header, body and footer are separate documents for wkhtmltopdf,
         so each block calls this template. Fonts come from akg_fonts. -->
    <!-- Oswald (Latin subset, embedded as data URI) so header, body and footer - which are three
         separate documents for wkhtmltopdf - all use the same font. Arabic falls back to DejaVu. -->
    <template id="akg_fonts">
        <t t-set="fco" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <style><t t-out="fco._akgr_font_css()"/></style>
    </template>

    <template id="akg_css">
        <t t-call="akg_report_layout.akg_fonts"/>
        <style>
            html .akgr.akgr { direction: ltr; unicode-bidi: embed; font-family: 'Oswald', 'DejaVu Sans Condensed', 'Liberation Sans Narrow', 'Arial Narrow', sans-serif; font-size: 15px; font-weight: bold; color: #222; }
            /* HARD RESET: some databases (themes / extra report css) draw borders on table, tbody, tr,
               td ... Nothing but the borders defined below may ever be drawn. */
            html body .akgr.akgr table, html body .akgr.akgr thead, html body .akgr.akgr tbody, html body .akgr.akgr tfoot, html body .akgr.akgr tr,
            html body .akgr.akgr td, html body .akgr.akgr th { border: 0 none !important; border-style: none !important; outline: 0 none !important; box-shadow: none !important; background-image: none !important; }
            html body .akgr.akgr table { border-spacing: 0; background: transparent; }
            html body .akgr.akgr hr { display: none; }
            /* Odoo 20 report css draws borders on every table: switch them all off ... */
            html .akgr.akgr table { border-collapse: collapse; width: 100%; border: 0 none !important; }
            html .akgr.akgr table td, html .akgr.akgr table th { border: 0 none !important; background: transparent; box-shadow: none; padding: 0; vertical-align: top; }
            /* ... and draw only the borders the AKG design wants */
            html .akgr.akgr table.lines { border-bottom: 2px solid #444 !important; }
            html .akgr.akgr table.lines th { border-top: 2px solid #444 !important; border-bottom: 2px solid #444 !important; padding: 7px 8px; text-align: right; font-size: 14px; font-weight: bold; color: #555; text-transform: uppercase; line-height: 1.5; }
            html .akgr.akgr table.lines td { border-bottom: 1px solid #ccc !important; border-left: 1px solid #ddd !important; padding: 12px 8px; text-align: right; }
            html .akgr.akgr table.lines th.l, html .akgr.akgr table.lines td.l { text-align: left; }
            html .akgr.akgr table.lines td.first, html .akgr.akgr table.lines td:first-child { border-left: 0 none !important; }
            html .akgr.akgr table.tot { border-bottom: 2px solid #444 !important; }
            html .akgr.akgr table.tot td { border: 1px solid #e3e3e3 !important; padding: 13px 9px; text-align: right; }
            html .akgr.akgr table.tot td.lb { text-align: left; }
            .akgr address { font-style: normal; margin: 0; line-height: 1.55; font-size: 15px; font-weight: bold; }
            .akgr a { color: #555; text-decoration: underline; }
            .akgr .teal { color: #1ca3b8; }
            .akgr .lb { color: #555; font-weight: bold; }
            .akgr .title { font-size: 34px; color: #1ca3b8; margin: 22px 0 14px 0; }
            .akgr .ar { font-family: 'DejaVu Sans', 'Noto Sans Arabic', sans-serif; font-weight: bold; color: #000; }
        </style>
    </template>

    <!-- THE header: div.header is extracted by Odoo and repeated on every page by wkhtmltopdf.
         Built from divs (display:table) - NOT <table> - so no report CSS can draw borders on it.
         Needs `company`. -->
    <template id="akg_header">
        <!-- In the Document Layout preview `company` is a base.document.layout wizard record -->
        <t t-set="co" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <t t-set="logo_uri" t-value="co._akgr_logo_uri()"/>
        <!-- wkhtmltopdf draws this block STARTING at (margin_top - header_spacing) = 38 - 28 = 10 mm, on EVERY page.
             It is ~22 mm tall (ends at ~32 mm); the document body starts at 38 mm. Keep natural height:
             no fixed height / padding-top / overflow here. To move it, change header_spacing only. -->
        <div class="header" dir="ltr" style="width:100%; margin:0; padding:0;">
            <t t-call="akg_report_layout.akg_css"/>
            <div class="akgr" style="display:table; width:100%;">
                <div style="display:table-cell; width:58%; vertical-align:top; text-align:left;">
                    <img t-if="logo_uri" t-att-src="logo_uri" style="max-height: 90px; max-width: 220px;"/>
                </div>
                <div style="display:table-cell; width:42%; vertical-align:top; text-align:left; padding-left:0; padding-top:6px; font-size:16px; line-height:1.95;">
                    <div style="font-weight:bold"><t t-out="co.name"/></div>
                    <div t-if="co.vat">Tax ID: <t t-out="co.vat"/></div>
                    <div t-if="co.website" style="color:#1a73e8;"><t t-out="co.website"/></div>
                </div>
            </div>
        </div>
    </template>

    <!-- Header printed INSIDE the page body (first thing of the document). Own reports use this one:
         it does not depend on wkhtmltopdf header positioning (margin_top / header_spacing).
         Class is "akgh", not "header", so Odoo does not extract it. Needs `company`. -->
    <template id="akg_header_inline">
        <t t-set="co" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <t t-set="logo_uri" t-value="co._akgr_logo_uri()"/>
        <div class="akgh" dir="ltr" style="width:100%; margin:0 0 14px 0; padding:0;">
            <div class="akgr" style="display:table; width:100%;">
                <div style="display:table-cell; width:58%; vertical-align:top; text-align:left;">
                    <img t-if="logo_uri" t-att-src="logo_uri" style="max-height: 90px; max-width: 220px;"/>
                </div>
                <div style="display:table-cell; width:42%; vertical-align:top; text-align:left; padding-left:0; padding-top:6px; font-size:16px; line-height:1.95;">
                    <div style="font-weight:bold"><t t-out="co.name"/></div>
                    <div t-if="co.vat">Tax ID: <t t-out="co.vat"/></div>
                    <div t-if="co.website" style="color:#1a73e8;"><t t-out="co.website"/></div>
                </div>
            </div>
        </div>
    </template>

    <!-- THE footer: div.footer, same technique. Needs `company`. -->
    <template id="akg_footer">
        <t t-set="co" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <t t-set="fv" t-value="co._akgr_footer_vals()"/>
        <t t-set="qr_uri" t-value="co._akgr_qr_uri()"/>
        <div class="footer" dir="ltr" style="width:100%; margin:0; padding:0;">
            <t t-call="akg_report_layout.akg_css"/>
            <div class="akgr" style="border-top: 2px solid #444; padding-top: 8px;">
                <div style="display:table; width:100%;">
                    <div style="display:table-cell; width:28%; vertical-align:top; font-size:13px; line-height:1.8; padding-top:8px;">
                        <div t-if="co.website" style="color:#1a73e8;"><t t-out="co.website"/></div>
                        <div>Tax Card No. <t t-out="fv['tax_card']"/></div>
                        <div>CR. No. <t t-out="fv['cr_no']"/></div>
                    </div>
                    <div style="display:table-cell; width:50%; vertical-align:top; text-align:center; padding-top:4px;">
                        <div class="ar" style="font-size:14px;"><t t-out="fv['ar_name']"/></div>
                        <div style="margin-top:12px; font-size:15px;">
                            <t t-out="fv['thank_en']"/> <span class="ar"><t t-out="fv['thank_ar']"/></span>
                        </div>
                    </div>
                    <div style="display:table-cell; width:22%; vertical-align:top; text-align:right;">
                        <img t-if="qr_uri" t-att-src="qr_uri" style="width:72px; height:72px;"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Inherit the Odoo 20 "Lines" layout: replace its decorative header/footer
         (SVG lines, address list, logo) with the AKG header/footer. -->
    <template id="external_layout_lines_akg" inherit_id="web.external_layout_lines" priority="99">
        <xpath expr="//div[contains(@t-attf-class, 'o_layout_lines_header')]" position="replace">
            <t t-call="akg_report_layout.akg_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
            <t t-call="akg_report_layout.akg_footer"/>
        </xpath>
    </template>

</odoo>
