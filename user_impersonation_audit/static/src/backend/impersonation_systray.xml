<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="user_impersonation_audit.Picker">
        <Dropdown state="this.dropdown" beforeOpen.bind="this.onBeforeOpen" position="'bottom-end'" menuClass="'o_uia_picker_menu p-0'">
            <button class="o_uia_picker_toggle" title="Log in as another user" aria-label="Log in as another user">
                <i class="oi oi-filled oi-lg" data-icon="person" role="img" aria-label="Log in as another user"/>
            </button>
            <t t-set-slot="content">
                <div class="o_uia_picker p-2">
                    <div class="fw-bold mb-2">Log in as...</div>
                    <input type="search" class="form-control form-control-sm mb-2 o_uia_picker_search"
                           placeholder="Search name or login" t-att-value="this.state.query"
                           t-on-input="this.onInput" t-on-keydown="this.onKeydown"/>
                    <select class="form-select form-select-sm mb-2 o_uia_picker_group" t-on-change="this.onGroupChange">
                        <option value="0">All groups</option>
                        <t t-foreach="this.state.groups" t-as="group" t-key="group.id">
                            <option t-att-value="group.id" t-att-selected="group.id === this.state.groupId" t-out="group.name"/>
                        </t>
                    </select>
                    <div class="o_uia_picker_list list-group list-group-flush">
                        <t t-foreach="this.state.users" t-as="u" t-key="u.id">
                            <div class="list-group-item list-group-item-action d-flex align-items-center px-2 py-1 o_uia_picker_user">
                                <img class="rounded me-2 o_uia_picker_avatar" t-attf-src="/web/image/res.users/{{u.id}}/avatar_128" alt=""/>
                                <div class="flex-grow-1 text-truncate cursor-pointer" t-on-click="() => this.openWizard(u)">
                                    <div class="text-truncate">
                                        <t t-out="u.name"/>
                                        <span t-if="u.portal" class="badge text-bg-warning ms-1">Portal</span>
                                        <span t-if="u.recent" class="badge text-bg-light ms-1">Recent</span>
                                    </div>
                                    <div class="small text-muted text-truncate"><t t-out="u.login"/> · <t t-out="u.company"/></div>
                                </div>
                                <button class="btn btn-link btn-sm p-1 o_uia_favorite" t-on-click.stop="() => this.toggleFavorite(u)"
                                        t-att-title="u.favorite ? 'Remove from favourites' : 'Add to favourites'">
                                    <i t-att-class="u.favorite ? 'oi oi-filled text-warning' : 'oi text-muted'" data-icon="star"/>
                                </button>
                            </div>
                        </t>
                        <div t-if="this.state.loaded and !this.state.users.length" class="text-muted small p-2">No user found.</div>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
