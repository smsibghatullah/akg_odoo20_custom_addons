<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_impersonation_consent_list" model="ir.ui.view">
        <field name="name">user.impersonation.consent.list</field>
        <field name="model">user.impersonation.consent</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Asked on"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="target_id" widget="many2one_avatar_user"/>
                <field name="reason"/>
                <field name="decision_date"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'used')"
                       decoration-warning="state == 'pending'" decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="view_impersonation_consent_form" model="ir.ui.view">
        <field name="name">user.impersonation.consent.form</field>
        <field name="model">user.impersonation.consent</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_approve" type="object" string="Allow access" class="btn-primary"
                            invisible="state != 'pending' or target_id != uid"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'pending' or target_id != uid"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,used"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="requester_id" widget="many2one_avatar_user"/>
                            <field name="target_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="reason_category"/>
                            <field name="reference"/>
                            <field name="decision_date"/>
                            <field name="valid_until"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <field name="reason"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_impersonation_consent_search" model="ir.ui.view">
        <field name="name">user.impersonation.consent.search</field>
        <field name="model">user.impersonation.consent</field>
        <field name="arch" type="xml">
            <search>
                <field name="requester_id"/>
                <field name="target_id"/>
                <filter name="filter_pending" string="Waiting" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_mine" string="Asked to me" domain="[('target_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_impersonation_consent" model="ir.actions.act_window">
        <field name="name">Consent requests</field>
        <field name="res_model">user.impersonation.consent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No consent request</p>
            <p>When a user requires consent, the request and the answer are kept here.</p>
        </field>
    </record>
</odoo>
