#. module: user_impersonation_audit
#: model:mail.template,body_html:user_impersonation_audit.mail_template_session_started
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p><t t-out=\"object.impersonator_id.name or ''\">Admin</t> logged in as <t t-out=\"object.target_id.name or ''\">User</t> to help.</p>\n"
"    <table style=\"border-collapse: collapse;\">\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Reason</td><td style=\"padding: 3px 0;\"><t t-out=\"object.reason or ''\">Reason</t></td></tr>\n"
"        <tr t-if=\"object.reference\"><td style=\"padding: 3px 12px 3px 0; color: #666;\">Reference</td><td style=\"padding: 3px 0;\"><t t-out=\"object.reference or ''\">TCK-1</t></td></tr>\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Started</td><td style=\"padding: 3px 0;\"><t t-out=\"format_datetime(object.start_date, tz=object.target_id.tz, dt_format='short')\">now</t></td></tr>\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Ends at the latest</td><td style=\"padding: 3px 0;\"><t t-out=\"format_datetime(object.planned_end_date, tz=object.target_id.tz, dt_format='short')\">later</t></td></tr>\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Mode</td><td style=\"padding: 3px 0;\"><t t-if=\"object.read_only\">Read-only</t><t t-else=\"\">Full access, every change is recorded</t></td></tr>\n"
"    </table>\n"
"    <p style=\"color: #666;\">You do not need to do anything. If you did not expect this, contact your administrator.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p><t t-out=\"object.impersonator_id.name or ''\">Admin</t> hat sich als <t t-out=\"object.target_id.name or ''\">User</t> angemeldet, um zu helfen.</p>\n"
"    <table style=\"border-collapse: collapse;\">\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Grund</td><td style=\"padding: 3px 0;\"><t t-out=\"object.reason or ''\">Reason</t></td></tr>\n"
"        <tr t-if=\"object.reference\"><td style=\"padding: 3px 12px 3px 0; color: #666;\">Referenz</td><td style=\"padding: 3px 0;\"><t t-out=\"object.reference or ''\">TCK-1</t></td></tr>\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Gestartet</td><td style=\"padding: 3px 0;\"><t t-out=\"format_datetime(object.start_date, tz=object.target_id.tz, dt_format='short')\">now</t></td></tr>\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Endet spätestens</td><td style=\"padding: 3px 0;\"><t t-out=\"format_datetime(object.planned_end_date, tz=object.target_id.tz, dt_format='short')\">later</t></td></tr>\n"
"        <tr><td style=\"padding: 3px 12px 3px 0; color: #666;\">Modus</td><td style=\"padding: 3px 0;\"><t t-if=\"object.read_only\">Schreibgeschützt</t><t t-else=\"\">Vollzugriff, jede Änderung wird protokolliert</t></td></tr>\n"
"    </table>\n"
"    <p style=\"color: #666;\">Sie müssen nichts tun. Falls Sie dies nicht erwartet haben, wenden Sie sich an Ihren Administrator.</p>\n"
"</div>\n"
"            "

#. module: user_impersonation_audit
#: model:mail.template,body_html:user_impersonation_audit.mail_template_session_summary
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p><t t-out=\"object.impersonator_id.name or ''\">Admin</t> was logged in as you for <t t-out=\"object.duration\">10</t> minutes.</p>\n"
"    <p><strong>Reason:</strong> <t t-out=\"object.reason or ''\">Reason</t></p>\n"
"    <t t-set=\"changes\" t-value=\"object.uia_changed_activities()\"/>\n"
"    <p t-if=\"not changes\">Nothing was created, changed or deleted.</p>\n"
"    <t t-else=\"\">\n"
"        <p>Records created, changed or deleted:</p>\n"
"        <ul>\n"
"            <li t-foreach=\"changes[:50]\" t-as=\"act\">\n"
"                <t t-out=\"act.model_description or act.model or ''\">Contact</t>:\n"
"                <t t-out=\"act.record_name or ''\">Name</t>\n"
"                (<t t-out=\"act.operation_label\">Changed</t><t t-if=\"act.summary and act.operation == 'write'\">: <t t-out=\"act.summary\"/></t>)\n"
"            </li>\n"
"        </ul>\n"
"    </t>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p><t t-out=\"object.impersonator_id.name or ''\">Admin</t> war für <t t-out=\"object.duration\">10</t> Minuten als Sie angemeldet.</p>\n"
"    <p><strong>Grund:</strong> <t t-out=\"object.reason or ''\">Reason</t></p>\n"
"    <t t-set=\"changes\" t-value=\"object.uia_changed_activities()\"/>\n"
"    <p t-if=\"not changes\">Es wurde nichts erstellt, geändert oder gelöscht.</p>\n"
"    <t t-else=\"\">\n"
"        <p>Erstellte, geänderte oder gelöschte Datensätze:</p>\n"
"        <ul>\n"
"            <li t-foreach=\"changes[:50]\" t-as=\"act\">\n"
"                <t t-out=\"act.model_description or act.model or ''\">Contact</t>:\n"
"                <t t-out=\"act.record_name or ''\">Name</t>\n"
"                (<t t-out=\"act.operation_label\">Changed</t><t t-if=\"act.summary and act.operation == 'write'\">: <t t-out=\"act.summary\"/></t>)\n"
"            </li>\n"
"        </ul>\n"
"    </t>\n"
"</div>\n"
"            "

