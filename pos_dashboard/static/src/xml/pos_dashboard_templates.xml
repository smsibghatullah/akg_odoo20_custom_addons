<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_dashboard.PosDashboard" owl="1">
        <div class="o_pos_dashboard">
            <div class="o_wh_dashboard_header">
                <h2>
                    <i class="fa fa-th-large me-2"/> Point of Sale Dashboard
                </h2>
                <button class="btn btn-primary o_wh_refresh_btn" t-on-click="this.refresh">
                    <i class="fa fa-refresh"/> Refresh
                </button>
            </div>

            <div t-if="this.state.loading" class="o_wh_dashboard_loading">
                <i class="fa fa-spinner fa-spin"/> Loading...
            </div>

            <div t-else="" class="o_wh_board">
                <div t-if="!this.state.posList.length" class="o_wh_dashboard_empty">
                    No records found.
                </div>

                <div t-foreach="this.state.posList" t-as="pos" t-key="pos.pos_name" class="o_wh_column">
                    <div class="o_wh_column_header" t-attf-style="border-top: 3px solid {{pos.color}};">
                        <span t-out="pos.pos_name"/>
                    </div>

                    <div class="o_wh_column_body">

                        <t t-foreach="pos.operations" t-as="op" t-key="op.code">
                            <div class="o_wh_card" t-attf-style="border-left: 4px solid {{pos.color}};">
                                <div class="o_wh_card_head">
                                    <span class="o_wh_card_title" t-out="op.label"/>
                                    <i class="fa fa-ellipsis-v o_wh_card_menu"/>
                                </div>
                                <div class="o_wh_card_subtitle" t-out="pos.pos_name"/>

                                <div class="o_wh_card_row">
                                    <button class="o_wh_process_btn"
                                            t-on-click="(ev) => this.openPicking(pos, op.code, op.label, 'all', ev)">
                                        <t t-out="op.to_process"/> TO PROCESS
                                    </button>

                                    <div class="o_wh_card_stats">
                                        <div t-if="op.waiting" class="o_wh_stat_link"
                                             t-on-click="(ev) => this.openPicking(pos, op.code, op.label + ' - Waiting', 'waiting', ev)">
                                            <t t-out="op.waiting"/> Waiting
                                        </div>
                                        <div t-if="op.late" class="o_wh_stat_link o_wh_stat_late"
                                             t-on-click="(ev) => this.openPicking(pos, op.code, op.label + ' - Late', 'late', ev)">
                                            <t t-out="op.late"/> Late
                                        </div>
                                        <div t-if="op.backorders" class="o_wh_stat_link"
                                             t-on-click="(ev) => this.openPicking(pos, op.code, op.label + ' - Back Orders', 'backorders', ev)">
                                            <t t-out="op.backorders"/> Back Orders
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
