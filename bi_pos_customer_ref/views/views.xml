<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_pos_form_inherit" model="ir.ui.view">
        <field name="name">pos.order.inherit.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Extra Information">
                    <field name="customer_reference" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_customer_reference" model="ir.ui.view">
        <field name="name">account.move.form.customer.reference</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="customer_reference" invisible="move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>

    <!--
        Unit price / discount lock on sale order lines.
        The Odoo 16 module replaced the whole order_line field with a copy of the core view. Odoo 20 does
        not allow `groups` on inherited view records, so only members of "Can Edit Unit Price and
        Discount" can edit price/discount (flag `can_edit_unit_price`, computed per user).
    -->
    <record id="view_order_form_price_unit_restrict" model="ir.ui.view">
        <field name="name">sale.order.form.price.unit.restrict</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="can_edit_unit_price" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not parent.can_edit_unit_price or qty_invoiced &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="attributes">
                <attribute name="readonly">not parent.can_edit_unit_price</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not parent.can_edit_unit_price</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="attributes">
                <attribute name="readonly">not parent.can_edit_unit_price</attribute>
            </xpath>
        </field>
    </record>
</odoo>
