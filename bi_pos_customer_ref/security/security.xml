<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19+/20: groups belong to a res.groups.privilege instead of a module category.
         (These records used to live in demo/demo.xml, which broke the install on Odoo 20.) -->
    <record id="res_groups_privilege_unit_price" model="res.groups.privilege">
        <field name="name">Edit Unit Price and Discount</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_can_edit_unit_price" model="res.groups">
        <field name="name">Can Edit Unit Price and Discount</field>
        <field name="privilege_id" ref="res_groups_privilege_unit_price"/>
    </record>

    <record id="group_cannot_edit_unit_price" model="res.groups">
        <field name="name">Cannot Edit Unit Price and Discount</field>
        <field name="privilege_id" ref="res_groups_privilege_unit_price"/>
    </record>
</odoo>
