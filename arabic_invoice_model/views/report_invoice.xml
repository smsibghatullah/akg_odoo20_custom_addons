<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Entry points: their names are written into the standard print actions
         (see data/report_action.xml). No xpath on core templates. -->
    <template id="report_invoice_arabic_with_payments">
        <t t-call="web.html_container">
            <t t-set="print_with_payments" t-value="True"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="arabic_invoice_model.arabic_english_invoice" t-lang="o._akg_report_lang()"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_arabic">
        <t t-call="web.html_container">
            <t t-set="print_with_payments" t-value="False"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="arabic_invoice_model.arabic_english_invoice" t-lang="o._akg_report_lang()"/>
            </t>
        </t>
    </template>

    <!-- SELF-CONTAINED document: own header, own footer, all CSS inline.
         It does not use web.external_layout and does not rely on Bootstrap.
         (Class names deliberately avoid the words header / footer / article,
          which Odoo's PDF engine looks for.) -->
    <template id="arabic_english_invoice">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="o_sec" t-value="o.with_context(lang='ar_001')"/>
        <t t-set="o" t-value="o.with_context(lang='en_US')"/>
        <t t-set="titles" t-value="o._akg_invoice_titles()"/>
        <t t-set="notes" t-value="o._akg_notes()"/>
        <t t-set="digits" t-value="o.currency_id.decimal_places"/>
        <t t-set="logo_uri" t-value="o._akg_logo_uri()"/>
        <t t-set="qr_uri" t-value="o._akg_qr_uri()"/>
        <!-- Edit these two values if they change -->
        <t t-set="tax_card_no" t-value="'8458551'"/>
        <t t-set="cr_no" t-value="company.company_registry or '1/02236/9'"/>

        <div class="akg-doc" style="font-family: 'Oswald', 'DejaVu Sans', Arial, sans-serif; font-size: 12px; color: #222; padding-bottom: 110px;">
            <style>
                .akg-doc table { border-collapse: collapse; width: 100%; }
                .akg-doc td, .akg-doc th { vertical-align: top; }
                .akg-doc .akg-lines th { border-top: 2px solid #444; border-bottom: 1px solid #444; padding: 5px 6px; text-align: right; font-size: 11px; text-transform: uppercase; }
                .akg-doc .akg-lines td { border-bottom: 1px solid #ccc; padding: 7px 6px; text-align: right; }
                .akg-doc .akg-tot td { border: 1px solid #ccc; padding: 7px 8px; text-align: right; }
                .akg-doc .akg-info td { padding: 2px 0; }
                .akg-doc .akg-teal { color: #1ca3b8; }
            </style>

            <!-- ============ TOP: logo + company ============ -->
            <table style="width:100%">
                <tr>
                    <td style="width:50%; text-align:left;">
                        <img t-if="logo_uri" t-att-src="logo_uri" style="max-height: 90px; max-width: 210px;"/>
                    </td>
                    <td style="width:50%; text-align:right; padding-top:6px; font-size:13px; line-height:1.6;">
                        <div style="font-weight:bold"><t t-out="company.name"/></div>
                        <div t-if="company.vat">Tax ID: <t t-out="company.vat"/></div>
                        <div t-if="company.website" style="color:#1a73e8;"><t t-out="company.website"/></div>
                    </td>
                </tr>
            </table>

            <!-- ============ Customer address (right) ============ -->
            <table style="width:100%; margin-top:14px;">
                <tr>
                    <td style="width:50%"/>
                    <td style="width:50%; text-align:right; font-size:13px; line-height:1.5;">
                        <address t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                                 style="margin:0; text-align:right;"/>
                        <div t-if="o.partner_id.vat">
                            <t t-if="company.account_fiscal_country_id.vat_label" t-out="company.account_fiscal_country_id.vat_label"/>
                            <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ============ Title row ============ -->
            <table style="width:100%; margin-top:10px;">
                <tr>
                    <td style="width:36%; text-align:left; font-size:20px; font-weight:bold;" class="akg-teal">
                        <t t-out="titles[0]"/>
                    </td>
                    <td style="width:28%; text-align:center; font-size:20px; font-weight:bold;" class="akg-teal">
                        <t t-if="o.name and o.name != '/'" t-out="o.name"/>
                    </td>
                    <td style="width:36%; text-align:right; font-size:20px; font-weight:bold;" class="akg-teal">
                        <t t-out="titles[1]"/>
                    </td>
                </tr>
            </table>

            <!-- ============ Information block ============ -->
            <table style="width:100%; margin:10px 0 12px 0;">
                <tr>
                    <td style="width:50%; padding-right:14px;">
                        <table class="akg-info">
                            <tr t-if="o._akg_customer_phone()">
                                <td style="width:36%; font-weight:bold; white-space:nowrap;">Customer Mobile:</td>
                                <td style="width:30%; text-align:center;"><t t-out="o._akg_customer_phone()"/></td>
                                <td style="width:34%; text-align:right; font-weight:bold; white-space:nowrap;">: رقم هاتف العميل</td>
                            </tr>
                            <tr t-if="o.invoice_user_id">
                                <td style="font-weight:bold; white-space:nowrap;">Salesperson:</td>
                                <td style="text-align:center;"><t t-out="o.invoice_user_id.name"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: مندوب مبيعات</td>
                            </tr>
                            <tr t-if="o._akg_salesperson_phone()">
                                <td style="font-weight:bold; white-space:nowrap;">Mobile:</td>
                                <td style="text-align:center;"><t t-out="o._akg_salesperson_phone()"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: رقم الهاتف</td>
                            </tr>
                            <tr t-if="o.partner_id.ref">
                                <td style="font-weight:bold; white-space:nowrap;">Customer Code:</td>
                                <td style="text-align:center;"><t t-out="o.partner_id.ref"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: كود العميل</td>
                            </tr>
                            <tr t-if="o._akg_customer_reference()">
                                <td style="font-weight:bold; white-space:nowrap;">Customer Ref:</td>
                                <td style="text-align:center;"><t t-out="o._akg_customer_reference()"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: مرجع العميل</td>
                            </tr>
                        </table>
                    </td>
                    <td style="width:50%; padding-left:14px;">
                        <table class="akg-info">
                            <tr t-if="o.invoice_date">
                                <td style="width:34%; font-weight:bold; white-space:nowrap;">Invoice Date:</td>
                                <td style="width:30%; text-align:center;"><span t-field="o.invoice_date"/></td>
                                <td style="width:36%; text-align:right; font-weight:bold; white-space:nowrap;">: تاريخ الفاتورة</td>
                            </tr>
                            <tr t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                                <td style="font-weight:bold; white-space:nowrap;">Due Date:</td>
                                <td style="text-align:center;"><span t-field="o.invoice_date_due"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: تاريخ الاستحقاق</td>
                            </tr>
                            <tr t-if="o.invoice_origin">
                                <td style="font-weight:bold; white-space:nowrap;">Source:</td>
                                <td style="text-align:center;"><t t-out="o.invoice_origin"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: المصدر</td>
                            </tr>
                            <tr t-if="o.ref">
                                <td style="font-weight:bold; white-space:nowrap;">Reference:</td>
                                <td style="text-align:center;"><t t-out="o.ref"/></td>
                                <td style="text-align:right; font-weight:bold; white-space:nowrap;">: رقم الإشارة</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ============ Lines ============ -->
            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
            <table class="akg-lines">
                <thead>
                    <tr>
                        <th style="width:13%"><div>السعر الاجمالي</div><div>Total Price</div></th>
                        <th style="width:10%"><div>قيمة الضريبة</div><div>VAT Amount</div></th>
                        <th style="width:10%"><div>مبلغ</div><div>Amount</div></th>
                        <th style="width:12%"><div>الضرائب</div><div>Taxes</div></th>
                        <th t-if="display_discount" style="width:7%"><div>خصم %</div><div>Disc.%</div></th>
                        <th style="width:11%"><div>سعر الوحدة</div><div>Unit Price</div></th>
                        <th style="width:9%"><div>الكمية</div><div>Quantity</div></th>
                        <th><div>الوصف</div><div>Description</div></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="current_section" t-value="False"/>
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (l.sequence, l.id))"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type not in ('line_note', 'line_section')">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                            <tr>
                                <td style="white-space:nowrap;"><span t-field="line.price_total"/></td>
                                <td style="white-space:nowrap;">
                                    <span t-out="line.price_total - line.price_subtotal" t-options='{"widget": "float", "precision": digits}'/>
                                </td>
                                <td style="white-space:nowrap;">
                                    <span t-out="line.price_subtotal" t-options='{"widget": "float", "precision": digits}'/>
                                </td>
                                <td><span t-out="', '.join(x.description or x.name for x in line.tax_ids)"/></td>
                                <td t-if="display_discount"><span t-field="line.discount"/></td>
                                <td style="white-space:nowrap;"><span t-field="line.price_unit"/></td>
                                <td style="white-space:nowrap;">
                                    <span t-field="line.quantity"/>
                                    <span t-if="line.product_uom_id" t-field="line.product_uom_id"/>
                                </td>
                                <td>
                                    <t t-if="line.product_id">
                                        <t t-set="english_name" t-value="line.product_id.with_context(lang='en_US').display_name"/>
                                        <t t-set="arabic_name" t-value="line.product_id.with_context(lang='ar_001').display_name"/>
                                        <div t-if="line.name and arabic_name not in line.name"><t t-out="arabic_name"/></div>
                                        <div t-if="line.name and (english_name != arabic_name) and (english_name not in line.name)"><t t-out="english_name"/></div>
                                    </t>
                                    <div style="white-space: pre-line;"><t t-out="line.name"/></div>
                                </td>
                            </tr>
                        </t>
                        <t t-if="line.display_type == 'line_section'">
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subtotal" t-value="0"/>
                            <tr><td colspan="99" style="background:#eee; font-weight:bold;"><t t-out="line.name"/></td></tr>
                        </t>
                        <t t-if="line.display_type == 'line_note'">
                            <tr><td colspan="99" style="font-style:italic;"><t t-out="line.name"/></td></tr>
                        </t>
                        <t t-if="current_section and (line_last or lines[line_index + 1].display_type == 'line_section')">
                            <tr>
                                <td colspan="99" style="font-weight:bold;">
                                    Subtotal / الإجمالي الفرعي
                                    <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- ============ Totals ============ -->
            <table style="width:100%; margin-top:18px; page-break-inside: avoid;">
                <tr>
                    <td style="width:47%">
                        <table class="akg-tot">
                            <tr>
                                <td style="width:50%"><span t-field="o.amount_untaxed"/></td>
                                <td style="font-weight:bold;">Subtotal / الإجمالي الفرعي</td>
                            </tr>
                            <t t-foreach="o._akg_tax_group_lines()" t-as="tax_group">
                                <tr>
                                    <td><span t-out="tax_group['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td style="font-weight:bold;">
                                        <t t-out="tax_group['name']"/>
                                        <t t-if="tax_group['name_ar']"> / <t t-out="tax_group['name_ar']"/></t>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td><span t-field="o.amount_total"/></td>
                                <td style="font-weight:bold;">Total / المجموع</td>
                            </tr>
                            <t t-if="print_with_payments">
                                <t t-set="payments_vals" t-value="o._akg_payment_lines()"/>
                                <t t-foreach="payments_vals" t-as="payment_vals">
                                    <tr>
                                        <td><span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td style="font-style:italic;">Paid on/دفعت في: <t t-out="payment_vals['date']"/></td>
                                    </tr>
                                </t>
                                <tr t-if="payments_vals">
                                    <td><span t-field="o.amount_residual"/></td>
                                    <td style="font-weight:bold;">Amount Due / المبلغ المستحق</td>
                                </tr>
                            </t>
                        </table>
                    </td>
                    <td style="width:53%"/>
                </tr>
            </table>

            <!-- ============ Payment reference + notes ============ -->
            <table t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference"
                   style="width:100%; margin-top:16px;">
                <tr>
                    <td style="width:25%; font-weight:bold; white-space:nowrap;">Payment Reference :</td>
                    <td style="width:50%; text-align:center; font-weight:bold;"><t t-out="o.payment_reference"/></td>
                    <td style="width:25%; text-align:right;">: رقم إشارة الدفعة</td>
                </tr>
            </table>

            <table t-if="notes['term']['en']" style="width:100%; margin-top:8px;">
                <tr>
                    <td style="width:50%;"><t t-out="notes['term']['en']"/></td>
                    <td style="width:50%; text-align:right;" dir="rtl"><t t-if="notes['term']['ar']" t-out="notes['term']['ar']"/></td>
                </tr>
            </table>
            <table t-if="notes['narration']['en']" style="width:100%; margin-top:8px;">
                <tr>
                    <td style="width:50%;"><t t-out="notes['narration']['en']"/></td>
                    <td style="width:50%; text-align:right;" dir="rtl"><t t-if="notes['narration']['ar']" t-out="notes['narration']['ar']"/></td>
                </tr>
            </table>
            <table t-if="notes['fiscal']['en']" style="width:100%; margin-top:8px;">
                <tr>
                    <td style="width:50%;"><t t-out="notes['fiscal']['en']"/></td>
                    <td style="width:50%; text-align:right;" dir="rtl"><t t-if="notes['fiscal']['ar']" t-out="notes['fiscal']['ar']"/></td>
                </tr>
            </table>
            <table t-if="notes['incoterm_en']" style="width:100%; margin-top:8px;">
                <tr>
                    <td style="width:50%;"><b>Incoterm:</b> <t t-out="notes['incoterm_en']"/></td>
                    <td style="width:50%; text-align:right;"><b>شرط تجاري:</b> <t t-out="notes['incoterm_ar']"/></td>
                </tr>
            </table>

            <!-- ============ Bottom block, pinned to the bottom of every page ============ -->
            <div style="position: fixed; bottom: 0; left: 0; right: 0; border-top: 2px solid #444; padding-top: 6px; background: #fff;">
                <table style="width:100%">
                    <tr>
                        <td style="width:28%; font-size:10px; line-height:1.6;">
                            <div t-if="company.website" style="color:#1a73e8;"><t t-out="company.website"/></div>
                            <div>Tax Card No. <t t-out="tax_card_no"/></div>
                            <div>CR. No. <t t-out="cr_no"/></div>
                        </td>
                        <td style="width:50%; text-align:center; font-size:12px; font-weight:bold; line-height:1.6;">
                            <t t-if="company.report_footer" t-out="company.report_footer"/>
                        </td>
                        <td style="width:22%; text-align:right;">
                            <img t-if="qr_uri" t-att-src="qr_uri" style="width:70px; height:70px;"/>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>
</odoo>
