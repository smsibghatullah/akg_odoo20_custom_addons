<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Entry points: these names are written into the standard print actions
         (see data/report_action.xml). No xpath on core templates. -->
    <template id="report_invoice_arabic_with_payments">
        <t t-call="web.html_container">
            <t t-set="print_with_payments" t-value="True"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="arabic_invoice_model.arabic_english_invoice" t-lang="o._akg_report_lang()"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_arabic">
        <t t-call="web.html_container">
            <t t-set="print_with_payments" t-value="False"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="arabic_invoice_model.arabic_english_invoice" t-lang="o._akg_report_lang()"/>
            </t>
        </t>
    </template>

    <template id="arabic_english_invoice">
        <t t-call="web.external_layout">
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
            <t t-set="address">
                <address t-field="o.partner_id"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                         style="text-align: right"/>
                <div t-if="o.partner_id.vat" class="mt16" style="text-align: right">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                       t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                </div>
            </t>

            <t t-set="o_sec" t-value="o.with_context(lang='ar_001')"/>
            <t t-set="o" t-value="o.with_context(lang='en_US')"/>
            <t t-set="titles" t-value="o._akg_invoice_titles()"/>
            <t t-set="notes" t-value="o._akg_notes()"/>
            <t t-set="currency_digits" t-value="o.currency_id.decimal_places"/>

            <div class="page">
                <h3>
                    <div class="row">
                        <div class="col-4" style="text-align:left">
                            <span t-out="titles[0]"/>
                        </div>
                        <div class="col-4 text-center">
                            <span t-if="o.name and o.name != '/'" t-out="o.name"/>
                        </div>
                        <div class="col-4" style="text-align:right">
                            <span t-out="titles[1]"/>
                        </div>
                    </div>
                </h3>

                <!-- Information block: two halves, each "EN label | value | AR label" -->
                <div id="informations" class="pb-3">
                    <div class="row">
                        <div class="col-6">
                            <div class="row" t-if="o._akg_customer_phone()" name="customer_mobile">
                                <div class="col-4"><strong style="white-space:nowrap">Customer Mobile:</strong></div>
                                <div class="col-4 text-center"><span t-out="o._akg_customer_phone()"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: رقم هاتف العميل</strong></div>
                            </div>
                            <div class="row" t-if="o.invoice_user_id" name="salesperson">
                                <div class="col-4"><strong style="white-space:nowrap">Salesperson:</strong></div>
                                <div class="col-4 text-center"><span t-out="o.invoice_user_id.name"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: مندوب مبيعات</strong></div>
                            </div>
                            <div class="row" t-if="o._akg_salesperson_phone()" name="salesperson_mobile">
                                <div class="col-4"><strong style="white-space:nowrap">Mobile:</strong></div>
                                <div class="col-4 text-center"><span t-out="o._akg_salesperson_phone()"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: رقم الهاتف</strong></div>
                            </div>
                            <div class="row" t-if="o.partner_id.ref" name="customer_code">
                                <div class="col-4"><strong style="white-space:nowrap">Customer Code:</strong></div>
                                <div class="col-4 text-center"><span t-field="o.partner_id.ref"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: كود العميل</strong></div>
                            </div>
                            <div class="row" t-if="o._akg_customer_reference()" name="customer_reference">
                                <div class="col-4"><strong style="white-space:nowrap">Customer Ref:</strong></div>
                                <div class="col-4 text-center"><span t-out="o._akg_customer_reference()"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: مرجع العميل</strong></div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="row" t-if="o.invoice_date" name="invoice_date">
                                <div class="col-4"><strong style="white-space:nowrap">Invoice Date:</strong></div>
                                <div class="col-4 text-center"><span t-field="o.invoice_date"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: تاريخ الفاتورة</strong></div>
                            </div>
                            <div class="row"
                                 t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'"
                                 name="due_date">
                                <div class="col-4"><strong style="white-space:nowrap">Due Date:</strong></div>
                                <div class="col-4 text-center"><span t-field="o.invoice_date_due"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: تاريخ الاستحقاق</strong></div>
                            </div>
                            <div class="row" t-if="o.invoice_origin" name="origin">
                                <div class="col-4"><strong style="white-space:nowrap">Source:</strong></div>
                                <div class="col-4 text-center"><span t-field="o.invoice_origin"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: المصدر</strong></div>
                            </div>
                            <div class="row" t-if="o.ref" name="reference">
                                <div class="col-4"><strong style="white-space:nowrap">Reference:</strong></div>
                                <div class="col-4 text-center"><span t-field="o.ref"/></div>
                                <div class="col-4 text-end"><strong style="white-space:nowrap">: رقم الإشارة</strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <table class="table table-sm o_main_table" name="invoice_line_table">
                    <thead>
                        <tr>
                            <th name="th_total" class="text-end">
                                <span>السعر الاجمالي</span><br/><span>Total Price</span>
                            </th>
                            <th name="th_tax_amount" class="text-end">
                                <span>قيمة الضريبة</span><br/><span>VAT Amount</span>
                            </th>
                            <th name="th_subtotal" class="text-end">
                                <span>مبلغ</span><br/><span>Amount</span>
                            </th>
                            <th name="th_taxes" class="text-end">
                                <span>الضرائب</span><br/><span>Taxes</span>
                            </th>
                            <th name="th_discount" t-if="display_discount" class="text-end">
                                <span>خصم %</span><br/><span>Disc.%</span>
                            </th>
                            <th name="th_priceunit" class="text-end">
                                <span>سعر الوحدة</span><br/><span>Unit price</span>
                            </th>
                            <th name="th_quantity" class="text-end">
                                <span>الكمية</span><br/><span>Quantity</span>
                            </th>
                            <th name="th_description" class="text-end">
                                <span>الوصف</span><br/><span>Description</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="current_section" t-value="False"/>
                        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (l.sequence, l.id))"/>

                        <t t-foreach="lines" t-as="line">
                            <t t-if="line.display_type not in ('line_note', 'line_section')">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                            </t>

                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type not in ('line_note', 'line_section')" name="account_invoice_line_accountable">
                                    <td class="text-end o_price_total">
                                        <span class="text-nowrap" t-field="line.price_total"/>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-nowrap"
                                              t-out="line.price_total - line.price_subtotal"
                                              t-options='{"widget": "float", "precision": currency_digits}'/>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-nowrap"
                                              t-out="line.price_subtotal"
                                              t-options='{"widget": "float", "precision": currency_digits}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="', '.join(x.description or x.name for x in line.tax_ids)" id="line_tax_ids"/>
                                    </td>
                                    <td t-if="display_discount" class="text-end">
                                        <span class="text-nowrap" t-field="line.discount"/>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-nowrap" t-field="line.price_unit"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                        <span t-if="line.product_uom_id" t-field="line.product_uom_id"/>
                                    </td>
                                    <td name="account_invoice_line_name" class="text-end">
                                        <t t-if="line.product_id">
                                            <t t-set="english_name" t-value="line.product_id.with_context(lang='en_US').display_name"/>
                                            <t t-set="arabic_name" t-value="line.product_id.with_context(lang='ar_001').display_name"/>
                                            <span t-out="arabic_name + '\n'"
                                                  t-if="line.name and arabic_name not in line.name"
                                                  t-options="{'widget': 'text'}"/>
                                            <span t-out="english_name + '\n'"
                                                  t-if="line.name and (english_name != arabic_name) and (english_name not in line.name)"
                                                  t-options="{'widget': 'text'}"/>
                                        </t>
                                        <span t-out="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-out="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-out="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>

                            <t t-if="current_section and (line_last or lines[line_index + 1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16" style="display: inline-block">Subtotal/الإجمالي الفرعي</strong>
                                        <span t-out="current_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix pt-4 pb-3">
                    <div id="total" class="row">
                        <div class="col-6">
                            <table class="table table-sm" style="page-break-inside: avoid;">
                                <tr class="border-black o_subtotal">
                                    <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                                    <td class="text-end"><strong>Subtotal / الإجمالي الفرعي</strong></td>
                                </tr>
                                <t t-foreach="o._akg_tax_group_lines()" t-as="tax_group">
                                    <tr>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap"
                                                  t-out="tax_group['amount']"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-out="tax_group['name']"/>
                                                <span t-if="tax_group['name_ar']" class="text-nowrap">/
                                                    <t t-out="tax_group['name_ar']"/>
                                                </span>
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="border-black o_total">
                                    <td class="text-end"><span class="text-nowrap" t-field="o.amount_total"/></td>
                                    <td class="text-end"><strong>Total / المجموع</strong></td>
                                </tr>

                                <t t-if="print_with_payments">
                                    <t t-set="payments_vals" t-value="o._akg_payment_lines()"/>
                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                        <tr class="border-black o_total">
                                            <td>
                                                <i class="row">
                                                    <div class="col-7 oe_form_field oe_payment_label">Paid on/دفعت في:</div>
                                                    <div class="col-5 ps-0 oe_form_field oe_payment_label">
                                                        <t t-out="payment_vals['date']"/>
                                                    </div>
                                                </i>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="payment_vals['amount']"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="payments_vals">
                                        <tr class="border-black">
                                            <td><strong>Amount Due / المبلغ المستحق</strong></td>
                                            <td class="text-end"><span t-field="o.amount_residual"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>

                <div t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference"
                     name="payment_communication" class="row pt-1 pb-2">
                    <div class="col-3 text-nowrap"><strong>Payment Reference :</strong></div>
                    <div class="col-6 text-center"><b><span t-field="o.payment_reference"/></b></div>
                    <div class="col-3 text-end">: رقم إشارة الدفعة</div>
                </div>

                <div t-if="notes['term']['en']" name="payment_term" class="row">
                    <div class="col-6 text-start"><span t-out="notes['term']['en']"/></div>
                    <div class="col-6 text-end">
                        <span t-if="notes['term']['ar']" dir="rtl" t-out="notes['term']['ar']"/>
                    </div>
                </div>
                <div t-if="notes['narration']['en']" name="comment" class="row">
                    <div class="col-6 text-start"><span t-out="notes['narration']['en']"/></div>
                    <div class="col-6 text-end">
                        <span t-if="notes['narration']['ar']" dir="rtl" t-out="notes['narration']['ar']"/>
                    </div>
                </div>
                <div t-if="notes['fiscal']['en']" name="note" class="row">
                    <div class="col-6 text-start"><span t-out="notes['fiscal']['en']"/></div>
                    <div class="col-6 text-end">
                        <span t-if="notes['fiscal']['ar']" dir="rtl" t-out="notes['fiscal']['ar']"/>
                    </div>
                </div>
                <div t-if="notes['incoterm_en']" name="incoterm" class="row">
                    <div class="col-6 text-start"><strong>Incoterm:</strong> <span t-out="notes['incoterm_en']"/></div>
                    <div class="col-6 text-end"><strong>شرط تجاري:</strong> <span t-out="notes['incoterm_ar']"/></div>
                </div>
            </div>
        </t>
    </template>
</odoo>
