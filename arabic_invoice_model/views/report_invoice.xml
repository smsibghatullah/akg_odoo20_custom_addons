<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Entry points: their names are written into the standard print actions
         (see data/report_action.xml). No xpath on core templates. -->
    <template id="report_invoice_arabic_with_payments">
        <t t-call="web.html_container">
            <t t-set="print_with_payments" t-value="True"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="arabic_invoice_model.arabic_english_invoice" t-lang="o._akg_report_lang()"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_arabic">
        <t t-call="web.html_container">
            <t t-set="print_with_payments" t-value="False"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="arabic_invoice_model.arabic_english_invoice" t-lang="o._akg_report_lang()"/>
            </t>
        </t>
    </template>

    <!-- SELF-CONTAINED document: own header, own footer, all CSS inline.
         No web.external_layout, no Bootstrap. The outer div MUST keep
         class "article" + data-oe-* (Odoo's PDF engine needs it for UTF-8 and
         for splitting the PDF per record). -->
    <template id="arabic_english_invoice">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="o_sec" t-value="o.with_context(lang='ar_001')"/>
        <t t-set="o" t-value="o.with_context(lang='en_US')"/>
        <t t-set="titles" t-value="o._akg_invoice_titles()"/>
        <t t-set="notes" t-value="o._akg_notes()"/>
        <t t-set="digits" t-value="o.currency_id.decimal_places"/>

        <!-- Footer texts (Tax card, CR no., Arabic name, Thank you) are edited in akg_report_layout -->

        <div t-attf-class="article akg-doc o_company_#{company.id}_layout" dir="ltr"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')"
             style="padding-bottom: 10px;">
            <style>
                @font-face { font-family: 'Oswald'; font-weight: normal;
                    src: url('/arabic_invoice_model/static/src/fonts/Oswald-Regular.ttf') format('truetype'); }
                @font-face { font-family: 'Oswald'; font-weight: bold;
                    src: url('/arabic_invoice_model/static/src/fonts/Oswald-Bold.ttf') format('truetype'); }
                /* WEIGHT RULES (same as the Odoo 16 invoice): text = normal, labels / headings / totals labels = bold */
                .akg-doc { direction: ltr; unicode-bidi: embed; font-family: 'Oswald', 'DejaVu Sans Condensed', 'DejaVu Sans', 'Noto Sans Arabic', sans-serif; font-size: 15px; font-weight: normal; font-style: normal; color: #222; }
                .akg-doc, .akg-doc * { font-style: normal; }
                .akg-doc address, .akg-doc address * { font-weight: normal !important; font-style: normal !important; }
                .akg-doc b, .akg-doc strong { font-weight: bold; }
                html .akg-doc.akg-doc table { border-collapse: collapse; width: 100%; border: 0 none !important; }
                html .akg-doc.akg-doc table td, html .akg-doc.akg-doc table th { border: 0 none !important; background: transparent; box-shadow: none; padding: 0; vertical-align: top; }
                html .akg-doc.akg-doc table.lines { border-bottom: 2px solid #444 !important; }
                html .akg-doc.akg-doc table.lines th { border-top: 2px solid #444 !important; border-bottom: 2px solid #444 !important; padding: 7px 8px; text-align: right; font-size: 14px; font-weight: bold; text-transform: uppercase; line-height: 1.5; }
                html .akg-doc.akg-doc table.lines td { border-bottom: 1px solid #ccc !important; border-left: 1px solid #ddd !important; padding: 14px 8px; text-align: right; font-weight: normal; }
                html .akg-doc.akg-doc table.lines td * { font-weight: normal; }
                html .akg-doc.akg-doc table.lines td:first-child { border-left: 0 none !important; }
                html .akg-doc.akg-doc table.tot td { border: 1px solid #e3e3e3 !important; padding: 15px 9px; text-align: right; font-weight: normal; }
                html .akg-doc.akg-doc table.info td { padding: 3px 0; font-size: 15px; font-weight: normal; }
                .akg-doc .ar { font-family: 'Oswald', 'DejaVu Sans', 'Noto Sans Arabic', sans-serif; font-weight: bold; color: #555; }
                .akg-doc .ar-n { font-family: 'Oswald', 'DejaVu Sans', 'Noto Sans Arabic', sans-serif; font-weight: normal; color: #222; }
                .akg-doc .teal { color: #1ca3b8; font-weight: bold; }
                .akg-doc .lines th .ar { font-size: 13px; text-transform: none; display: block; }
                .akg-doc .tot .lbl { font-weight: bold; color: #555; font-size: 14px; }
                .akg-doc .lb { font-weight: bold; }
            </style>

            <!-- Header printed inside the page body (logo + company name / Tax ID / website) -->
            <t t-call="arabic_invoice_model.akg_inv_header"/>

            <!-- ============ Customer address (right) ============ -->
            <table style="width:100%; margin-top:4px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:50%;border:0 none !important"/>
                    <td style="width:50%; text-align:right; font-size:16px; line-height:1.55;border:0 none !important">
                        <address t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                                 style="margin:0; text-align:right; font-style:normal;"/>
                        <div t-if="o.partner_id.vat">
                            <t t-out="o._akg_vat_label()"/>: <span t-field="o.partner_id.vat"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ============ Title row ============ -->
            <table style="width:100%; margin-top:14px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:38%; text-align:left; font-size:24px; white-space:nowrap;border:0 none !important" class="teal">
                        <t t-out="titles[0]"/>
                    </td>
                    <td style="width:26%; text-align:center; font-size:24px; font-weight:bold;border:0 none !important" class="teal">
                        <t t-if="o.name and o.name != '/'" t-out="o.name"/>
                    </td>
                    <td style="width:36%; text-align:right; font-size:24px; white-space:nowrap;border:0 none !important" class="teal">
                        <span class="ar teal"><t t-out="titles[1]"/></span>
                    </td>
                </tr>
            </table>

            <!-- ============ Information block ============ -->
            <table style="width:100%; margin:10px 0 18px 0;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:50%; padding-right:12px;border:0 none !important">
                        <table class="info" style="border:0 none !important">
                            <tr t-if="o._akg_customer_phone()" style="border:0 none !important">
                                <td style="width:34%; font-weight:bold; white-space:nowrap;border:0 none !important">Customer Mobile:</td>
                                <td style="width:28%; text-align:center;border:0 none !important"><t t-out="o._akg_customer_phone()"/></td>
                                <td style="width:38%; text-align:right; white-space:nowrap;border:0 none !important" class="ar">: رقم هاتف العميل</td>
                            </tr>
                            <tr t-if="o.invoice_user_id" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Salesperson:</td>
                                <td style="text-align:center;border:0 none !important"><t t-out="o.invoice_user_id.name"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: مندوب مبيعات</td>
                            </tr>
                            <tr t-if="o._akg_salesperson_phone()" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Mobile:</td>
                                <td style="text-align:center;border:0 none !important"><t t-out="o._akg_salesperson_phone()"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: رقم الهاتف</td>
                            </tr>
                            <tr t-if="o.partner_id.ref" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Customer Code:</td>
                                <td style="text-align:center;border:0 none !important"><t t-out="o.partner_id.ref"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: كود العميل</td>
                            </tr>
                            <tr t-if="o._akg_customer_reference()" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Customer Ref:</td>
                                <td style="text-align:center;border:0 none !important"><t t-out="o._akg_customer_reference()"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: مرجع العميل</td>
                            </tr>
                        </table>
                    </td>
                    <td style="width:50%; padding-left:12px;border:0 none !important">
                        <table class="info" style="border:0 none !important">
                            <tr t-if="o.invoice_date" style="border:0 none !important">
                                <td style="width:32%; font-weight:bold; white-space:nowrap;border:0 none !important">Invoice Date:</td>
                                <td style="width:30%; text-align:center;border:0 none !important"><span t-field="o.invoice_date"/></td>
                                <td style="width:38%; text-align:right; white-space:nowrap;border:0 none !important" class="ar">: تاريخ الفاتورة</td>
                            </tr>
                            <tr t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Due Date:</td>
                                <td style="text-align:center;border:0 none !important"><span t-field="o.invoice_date_due"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: تاريخ الاستحقاق</td>
                            </tr>
                            <tr t-if="o.invoice_origin" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Source:</td>
                                <td style="text-align:center;border:0 none !important"><t t-out="o.invoice_origin"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: المصدر</td>
                            </tr>
                            <tr t-if="o.ref" style="border:0 none !important">
                                <td style="font-weight:bold; white-space:nowrap;border:0 none !important">Reference:</td>
                                <td style="text-align:center;border:0 none !important"><t t-out="o.ref"/></td>
                                <td style="text-align:right; white-space:nowrap;border:0 none !important" class="ar">: رقم الإشارة</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ============ Lines ============ -->
            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
            <table class="lines" style="border:0 none !important;border-bottom:2px solid #444 !important">
                <thead style="border:0 none !important">
                    <tr style="border:0 none !important">
                        <th style="width:14%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">السعر الاجمالي</span>Total Price</th>
                        <th style="width:12%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">قيمة الضريبة</span>VAT Amount</th>
                        <th style="width:10%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">مبلغ</span>Amount</th>
                        <th style="width:12%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">الضرائب</span>Taxes</th>
                        <th t-if="display_discount" style="width:8%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">خصم %</span>Disc.%</th>
                        <th style="width:12%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">سعر الوحدة</span>Unit Price</th>
                        <th style="width:10%;border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">الكمية</span>Quantity</th>
                        <th style="border:0 none !important;border-top:2px solid #444 !important;border-bottom:2px solid #444 !important"><span class="ar">الوصف</span>Description</th>
                    </tr>
                </thead>
                <tbody style="border:0 none !important">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="current_section" t-value="False"/>
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (l.sequence, l.id))"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type not in ('line_note', 'line_section')">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                            <tr style="border:0 none !important">
                                <td style="white-space:nowrap; border-left:none;border:0 none !important;border-bottom:1px solid #ccc !important"><span t-field="line.price_total"/></td>
                                <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important">
                                    <span t-out="line.price_total - line.price_subtotal" t-options='{"widget": "float", "precision": digits}'/>
                                </td>
                                <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important">
                                    <span t-out="line.price_subtotal" t-options='{"widget": "float", "precision": digits}'/>
                                </td>
                                <td style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><span class="ar-n"><t t-out="', '.join(x.description or x.name for x in line.tax_ids)"/></span></td>
                                <td t-if="display_discount" style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><span t-field="line.discount"/></td>
                                <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important"><span t-field="line.price_unit"/></td>
                                <td style="white-space:nowrap;border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important">
                                    <span t-field="line.quantity"/>
                                    <span t-if="line.product_uom_id" t-field="line.product_uom_id"/>
                                </td>
                                <td style="border:0 none !important;border-bottom:1px solid #ccc !important;border-left:1px solid #ddd !important">
                                    <t t-set="names" t-value="o._akg_line_names(line)"/>
                                    <div t-if="names['ar']"><span class="ar-n"><t t-out="names['ar']"/></span></div>
                                    <div t-if="names['en']"><t t-out="names['en']"/></div>
                                    <div style="white-space: pre-line;"><t t-out="names['name']"/></div>
                                </td>
                            </tr>
                        </t>
                        <t t-if="line.display_type == 'line_section'">
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subtotal" t-value="0"/>
                            <tr style="border:0 none !important"><td colspan="99" style="background:#eee; font-weight:bold; border-left:none;border:0 none !important;border-bottom:1px solid #ccc !important"><t t-out="line.name"/></td></tr>
                        </t>
                        <t t-if="line.display_type == 'line_note'">
                            <tr style="border:0 none !important"><td colspan="99" style="font-style:italic; border-left:none;border:0 none !important;border-bottom:1px solid #ccc !important"><t t-out="line.name"/></td></tr>
                        </t>
                        <t t-if="current_section and (line_last or lines[line_index + 1].display_type == 'line_section')">
                            <tr style="border:0 none !important">
                                <td colspan="99" style="font-weight:bold; border-left:none;border:0 none !important;border-bottom:1px solid #ccc !important">
                                    Subtotal / <span class="ar">الإجمالي الفرعي</span>
                                    <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- ============ Totals ============ -->
            <table style="width:100%; margin-top:24px; page-break-inside: avoid;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:47%;border:0 none !important">
                        <table class="tot" style="border:0 none !important;border-bottom:2px solid #444 !important">
                            <tr style="border:0 none !important">
                                <td style="width:50%;border:1px solid #e3e3e3 !important"><span t-field="o.amount_untaxed"/></td>
                                <td class="lbl" style="border:1px solid #e3e3e3 !important">Subtotal / الإجمالي الفرعي</td>
                            </tr>
                            <t t-foreach="o._akg_tax_group_lines()" t-as="tax_group">
                                <tr style="border:0 none !important">
                                    <td style="border:1px solid #e3e3e3 !important"><span t-out="tax_group['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="lbl" style="border:1px solid #e3e3e3 !important">
                                        <t t-out="tax_group['name']"/>
                                        <t t-if="tax_group['name_ar']"> <t t-out="tax_group['name_ar']"/></t>
                                    </td>
                                </tr>
                            </t>
                            <tr style="border:0 none !important">
                                <td style="border:1px solid #e3e3e3 !important"><span t-field="o.amount_total"/></td>
                                <td class="lbl" style="border:1px solid #e3e3e3 !important">Total / المجموع</td>
                            </tr>
                            <t t-if="print_with_payments">
                                <t t-set="pay" t-value="o._akg_payment_summary()"/>
                                <t t-foreach="pay['lines']" t-as="payment_vals">
                                    <tr style="border:0 none !important">
                                        <td style="border:1px solid #e3e3e3 !important"><span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td style="font-style:italic;border:1px solid #e3e3e3 !important">
                                            <div style="font-style:italic;"><span class="ar-n" style="font-style:italic;font-weight:normal;">Paid on/دفعت في:</span></div>
                                            <div dir="ltr" style="text-align:left;"><t t-out="payment_vals['date']"/></div>
                                            <div t-if="payment_vals.get('method')" style="font-style:normal; color:#555;">
                                                <t t-out="payment_vals['method']"/>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                                <tr t-if="pay['lines']" style="border:0 none !important">
                                    <td style="border:1px solid #e3e3e3 !important"><span t-out="pay['due']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="lbl" style="border:1px solid #e3e3e3 !important">Amount Due / المبلغ المستحق</td>
                                </tr>
                            </t>
                        </table>
                    </td>
                    <td style="width:53%;border:0 none !important"/>
                </tr>
            </table>

            <!-- ============ Payment reference + notes ============ -->
            <table t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference"
                   style="width:100%; margin-top:22px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td class="lb" style="width:25%; white-space:nowrap;border:0 none !important">Payment Reference :</td>
                    <td style="width:50%; text-align:center; font-weight:bold;border:0 none !important"><t t-out="o.payment_reference"/></td>
                    <td style="width:25%; text-align:right;border:0 none !important" class="ar">: رقم إشارة الدفعة</td>
                </tr>
            </table>

            <table t-if="notes['term']['en']" style="width:100%; margin-top:10px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:50%;border:0 none !important"><t t-out="notes['term']['en']"/></td>
                    <td style="width:50%; text-align:right;border:0 none !important" dir="rtl"><span class="ar-n"><t t-if="notes['term']['ar']" t-out="notes['term']['ar']"/></span></td>
                </tr>
            </table>
            <t t-set="pos_note" t-value="o._akg_pos_note()"/>
            <table t-if="pos_note" style="width:100%; margin-top:14px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:12%; white-space:nowrap; font-weight:bold;border:0 none !important">Note:</td>
                    <td style="width:76%; white-space: pre-line;border:0 none !important"><t t-out="pos_note"/></td>
                    <td style="width:12%; text-align:right;border:0 none !important" class="ar">: ملاحظات</td>
                </tr>
            </table>
            <t t-set="terms" t-value="o._akg_terms()"/>
            <table t-if="terms[0]" style="width:100%; margin-top:14px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:50%;border:0 none !important"><t t-out="terms[0]"/></td>
                    <td style="width:50%; text-align:right;border:0 none !important" dir="rtl"><span class="ar-n"><t t-out="terms[1]"/></span></td>
                </tr>
            </table>
            <table t-if="notes['fiscal']['en']" style="width:100%; margin-top:10px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:50%;border:0 none !important"><t t-out="notes['fiscal']['en']"/></td>
                    <td style="width:50%; text-align:right;border:0 none !important" dir="rtl"><span class="ar-n"><t t-if="notes['fiscal']['ar']" t-out="notes['fiscal']['ar']"/></span></td>
                </tr>
            </table>
            <table t-if="notes['incoterm_en']" style="width:100%; margin-top:10px;border:0 none !important">
                <tr style="border:0 none !important">
                    <td style="width:50%;border:0 none !important"><span class="lb">Incoterm:</span> <t t-out="notes['incoterm_en']"/></td>
                    <td style="width:50%; text-align:right;border:0 none !important"><span class="ar">شرط تجاري:</span> <span class="ar-n"><t t-out="notes['incoterm_ar']"/></span></td>
                </tr>
            </table>

        </div>

        <!-- Shared footer (akg_report_layout) -->
        <t t-call="akg_report_layout.akg_footer"/>
    </template>

    <!-- Header block: logo left, company name (bold) / Tax ID / website right. Same as the Odoo 16 invoice. -->
    <template id="akg_inv_header">
        <table style="width:100%; margin:0 0 6px 0; border:0 none !important">
            <tr style="border:0 none !important">
                <td style="width:50%; border:0 none !important; vertical-align:top">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                         style="max-height:90px; max-width:240px" alt="Logo"/>
                </td>
                <td style="width:50%; border:0 none !important; vertical-align:top">
                    <div class="lb" style="font-size:15px; margin-bottom:10px; white-space:nowrap"><t t-out="company.name"/></div>
