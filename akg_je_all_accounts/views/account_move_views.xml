<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_allow_all_accounts" model="ir.ui.view">
        <field name="name">account.move.form.allow.all.accounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Journal Items tab (line_ids) : replace the account_type restriction -->
            <xpath expr="//field[@name='line_ids']//field[@name='account_id']" position="attributes">
                <attribute name="domain">[('company_ids', 'parent_of', parent.company_id)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
